{
  "implementation": {
    "models": {
      "claude": {
        "trivial": { "model": "claude-haiku-5-5", "effort": "medium" },
        "cheap": { "model": "claude-sonnet-5-5", "effort": "medium" },
        "standard": { "model": "claude-opus-5-5", "effort": "medium" },
        "capable": { "model": "claude-fable-5-2", "effort": "medium" }
      },
      "codex": {
        "trivial": "gpt-6-luna",
        "cheap": "gpt-6.1-terra",
        "standard": "gpt-6.1-sol",
        "capable": "gpt-6-astra"
      }
    }
  },
  "review": {
    "claude_api": false,
    "agents": ["claude", "codex"],
    "timeout": { "min_minutes": 10, "estimate_factor": 3 },
    "plan_light": { "max_tasks": 1, "max_files": 5 },
    "models": {
      "claude": {
        "spec": "claude-opus-5-5",
        "plan": "claude-opus-5-5",
        "code": "claude-opus-5-5",
        "code-task": "claude-opus-5-5"
      },
      "codex": {
        "spec": "gpt-6-sol",
        "plan": "gpt-6-sol",
        "code": "gpt-6-sol",
        "code-task": "gpt-6-sol"
      }
    }
  },
  "rules": { "root": "~/projects/rules" },
  "planning": { "track": "classic" },
  "gates": {
    "check": "claude plugin validate --strict . && claude plugin validate --strict ./.claude-plugin/plugin.json"
  }
}
